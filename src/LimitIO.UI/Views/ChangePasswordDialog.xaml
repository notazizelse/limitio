<Window x:Class="LimitIO.UI.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        Height="320" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Current password:" Margin="0,0,0,4" />
        <PasswordBox x:Name="OldPasswordBox" Grid.Row="1" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,10" />

        <TextBlock Grid.Row="2" Text="New password:" Margin="0,0,0,4" />
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="3" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,10" />

        <TextBlock Grid.Row="4" Text="Confirm new password:" Margin="0,0,0,4" />
        <PasswordBox x:Name="ConfirmBox" Grid.Row="5" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,10" />

        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,10,0" Click="CancelButton_Click" IsCancel="True" />
            <Button Content="Save" Width="80" Click="SaveButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
